  m_Script: {fileID: 11500000, guid: 7b921ed4c7800784cb4c90661492a9b3, type: 3}
  m_Name: St Andrews
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  characterName: Priest
  dialogueLines:
  - "Peace be with you, traveler. Drop your pack, you\u2019ve carried it far enough."
  - "You look like someone who has seen the better part of sixty miles. From the
    Abbey to the Sea, through the mud and the hills, that\u2019s no small feat."
  - Whatever you were looking for when you left the West, or whatever you needed
    to leave behind, I hope you found it in the silence of the miles.
  - "Take a breath. Let the sea air wash off the dust of the road. You\u2019ve finished
    your walk, pilgrim."
  - Now, carry that stillness back home with you.
  voiceType: Organ
  switchGroup: VoiceType
  genderPitch: -2400
  voiceWobble: 3
  typingSpeed: 0.2
