# Unity + C# Gitignore

# Based on: https://github.com/github/gitignore/blob/main/Unity.gitignore

##############################

# C# / Visual Studio / Rider

##############################

# User-specific files

*.rsuser
*.suo
*.user
*.userprefs
*.csproj.user
*.sln.docstates

# Mono auto-generated files

mono_crash.*

# Build results

[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Dd]ebug*/
[Rr]elease*/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/

# Visual Studio cache and generated files

.vs/
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb
*.pidb
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.booproj
*.svd
*.userprefs
*.sln.iml

# Rider

.idea/
*.sln.iml

# VS Code

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# NuGet

*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Others

*.log
*.cache
*.bak
*.tmp
*.swp
*.DS_Store
~$*

########################

# Unity Specific Files

########################

# Unity generated folders

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/UserSettings/

# Autogenerated project files

ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Rider plugin

/[Aa]ssets/Plugins/Editor/JetBrains*

# Gradle cache

.gradle/

# Unity meta-related generated files (NOT actual .meta files!)

*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports

sysinfo.txt
crashlytics-build.properties

# Unity builds

*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Addressables

/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

##################

# End of ignore

##################

# Visual Scripting auto-generated files

/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests

/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
